{
  "name": "yield-farm-companion",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npm run build && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run test:deployment && npm run build && python3 tools/validate_knowledge.py && npm run test:browser",
    "test:deployment": "python3 -m unittest discover -s tests/deployment -v",
    "deploy": "python3 tools/deploy.py",
    "deploy:status": "python3 tools/deploy.py --status",
    "analyze": "node tools/analyze.mjs",
    "monitor": "node tools/analyze.mjs --watch",
    "season": "node tools/season.mjs",
    "audit:site": "python tools/audit_site.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
